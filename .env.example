# Copy this file to .env and fill in the values. Never commit the real .env file.

# Connection string from your database host (for example Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Set to true when the database host needs SSL (Neon does)
DATABASE_SSL=true

# A long random text. Make one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-text

# The address of your website (no slash at the end). Several can be separated by commas.
CORS_ORIGIN=https://your-typeflow-site.netlify.app

PORT=4000
